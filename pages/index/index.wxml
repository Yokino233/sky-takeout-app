<view class="page">
  <!-- 店铺状态 -->
  <view class="shop-status {{shopOpen ? 'open' : 'closed'}}">
    {{shopOpen ? '营业中' : '打烊中'}}
  </view>

  <!-- 分类导航 -->
  <scroll-view class="category-bar" scroll-y>
    <view 
      class="category-item {{currentCategory === -1 ? 'active' : ''}}"
      data-id="-1"
      bindtap="switchCategory">
      全部
    </view>
    <view 
      wx:for="{{categories}}" 
      wx:key="id" 
      class="category-item {{currentCategory === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="switchCategory">
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 内容区 -->
  <scroll-view class="content-area" scroll-y>
    <!-- 菜品列表 -->
    <view wx:if="{{!showSetmeal}}">
      <view 
        wx:for="{{dishList}}" 
        wx:key="id" 
        class="dish-card card"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        data-price="{{item.price}}"
        data-image="{{item.image}}"
        data-dishFlavor="{{item.dishFlavor}}">
        <image class="dish-img" src='{{item.image}}' mode="aspectFill" data-index="{{index}}" data-type="{{showSetmeal ? 'setmeal' : 'dish'}}"></image>
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-desc" wx:if="{{item.description}}">{{item.description}}</view>
          <view class="dish-price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{item.price}}</text>
          </view>
        </view>
        <view class="add-btn" catchtap="addToCart" data-id="{{item.id}}" data-name="{{item.name}}" data-price="{{item.price}}" data-image="{{item.image}}">+</view>
      </view>
      <view wx:if="{{dishList.length === 0}}" class="empty-tip">暂无菜品</view>
    </view>

    <!-- 套餐列表 -->
    <view wx:if="{{showSetmeal}}">
      <view 
        wx:for="{{setmealList}}" 
        wx:key="id" 
        class="dish-card card"
        catchtap="viewSetmeal"
        data-id="{{item.id}}">
        <image class="dish-img" src='{{item.image}}' mode="aspectFill" data-index="{{index}}" data-type="{{showSetmeal ? 'setmeal' : 'dish'}}"></image>
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{item.price}}</text>
          </view>
        </view>
        <view class="add-btn" catchtap="addSetmealToCart" data-id="{{item.id}}" data-name="{{item.name}}" data-price="{{item.price}}" data-image="{{item.image}}">+</view>
      </view>
      <view wx:if="{{setmealList.length === 0}}" class="empty-tip">暂无套餐</view>
    </view>
  </scroll-view>
</view>

.page { padding: 20rpx; padding-bottom: 120rpx; }
.section { margin-bottom: 20rpx; }
.row { display: flex; align-items: center; }
.address-info { display: flex; align-items: center; padding: 10rpx 0; }
.addr-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; margin-right: 16rpx; }
.addr-text { flex: 1; }
.address-name { font-size: 28rpx; font-weight: bold; }
.address-detail { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.edit-hint { color: #ccc; font-size: 28rpx; }
.address-empty { display: flex; align-items: center; color: #999; font-size: 28rpx; padding: 10rpx 0; }
.small-icon { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.order-item { display: flex; align-items: center; }
.order-item-img { width: 100rpx; height: 100rpx; border-radius: 10rpx; flex-shrink: 0; }
.item-info { flex: 1; margin-left: 16rpx; }
.item-name { font-size: 28rpx; }
.item-flavor { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.item-right { text-align: right; }
.item-price { font-size: 26rpx; color: #ff6b35; }
.item-qty { font-size: 24rpx; color: #999; }
.remark-input { padding: 10rpx 0; font-size: 26rpx; flex: 1; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; background: #fff; padding: 20rpx; border-top: 2rpx solid #eee; }
.total { flex: 1; font-size: 28rpx; }
.total-price { color: #ff6b35; font-size: 32rpx; font-weight: bold; }
.submit-btn { padding: 16rpx 48rpx; background: #ff6b35; color: #fff; border-radius: 40rpx; font-size: 28rpx; }
.success-page { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.success-img { width: 200rpx; height: 200rpx; }
.success-text { font-size: 40rpx; font-weight: bold; margin-top: 40rpx; }
.success-desc { font-size: 28rpx; color: #999; margin-top: 16rpx; }
.back-btn { margin-top: 60rpx; padding: 20rpx 80rpx; background: #ff6b35; color: #fff; border-radius: 40rpx; font-size: 28rpx; }

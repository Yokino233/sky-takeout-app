.page { padding: 20rpx; padding-bottom: 120rpx; }
.empty { text-align: center; padding-top: 200rpx; }
.empty-img { width: 200rpx; height: 200rpx; }
.empty-text { display: block; margin-top: 20rpx; color: #999; font-size: 28rpx; }

.cart-item { display: flex; align-items: center; }
.item-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; }
.item-info { flex: 1; margin-left: 20rpx; }
.item-name { font-size: 28rpx; font-weight: bold; }
.item-flavor { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.item-price { font-size: 28rpx; color: #ff6b35; font-weight: bold; margin-top: 8rpx; }
.num-ctrl { display: flex; align-items: center; flex-shrink: 0; }
.num-btn { width: 48rpx; height: 48rpx; border: 2rpx solid #ddd; border-radius: 50%; text-align: center; line-height: 48rpx; font-size: 28rpx; color: #333; }
.num { margin: 0 16rpx; font-size: 28rpx; }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; background: #fff; padding: 20rpx; border-top: 2rpx solid #eee; }
.total { flex: 1; font-size: 28rpx; }
.total-price { color: #ff6b35; font-size: 32rpx; font-weight: bold; }
.clear-btn { padding: 16rpx 32rpx; border: 2rpx solid #ddd; border-radius: 40rpx; font-size: 26rpx; margin-right: 20rpx; }
.settle-btn { padding: 16rpx 48rpx; background: #ff6b35; color: #fff; border-radius: 40rpx; font-size: 28rpx; }

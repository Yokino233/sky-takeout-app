<view class="page" wx:if="{{order}}">
  <!-- 订单状态 -->
  <view class="status-bar">
    <text class="status-text">{{statusText[order.status]}}</text>
    <text class="status-desc" wx:if="{{order.status === 5}}">感谢您的光临</text>
    <text class="status-desc" wx:if="{{order.status === 6}}">订单已取消</text>
    <text class="status-desc" wx:if="{{order.status === 4}}">骑手正在配送中，如需催单请点击下方按钮</text>
    <text class="status-desc" wx:if="{{order.status < 3}}">商家正在处理您的订单</text>
  </view>

  <!-- 收货信息 -->
  <view class="section card">
    <view class="section-title">收货信息</view>
    <text class="info-text">{{order.consignee}}  {{order.phone}}</text>
    <text class="info-text addr">{{order.address}}</text>
  </view>

  <!-- 订单信息 -->
  <view class="section card">
    <view class="section-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{order.number}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.orderTime}}</text>
    </view>
    <view wx:if="{{order.checkoutTime}}" class="info-row">
      <text class="info-label">支付时间</text>
      <text class="info-value">{{order.checkoutTime}}</text>
    </view>
    <view wx:if="{{order.cancelTime}}" class="info-row">
      <text class="info-label">取消时间</text>
      <text class="info-value">{{order.cancelTime}}</text>
    </view>
    <view wx:if="{{order.cancelReason}}" class="info-row">
      <text class="info-label">取消原因</text>
      <text class="info-value">{{order.cancelReason}}</text>
    </view>
    <view wx:if="{{order.rejectionReason}}" class="info-row">
      <text class="info-label">拒单原因</text>
      <text class="info-value">{{order.rejectionReason}}</text>
    </view>
  </view>

  <!-- 菜品列表 -->
  <view class="section card">
    <view class="section-title">菜品明细</view>
    <view class="detail-item" wx:for="{{order.orderDetailList}}" wx:key="id">
      <image class="detail-img" src="{{item.image && item.image.indexOf('http')===0 ? item.image : 'http://localhost:8080' + (item.image || '')}}" mode="aspectFill"></image>
      <view class="detail-info">
        <text class="detail-name">{{item.name}}</text>
        <text wx:if="{{item.dishFlavor}}" class="detail-flavor">{{item.dishFlavor}}</text>
      </view>
      <text class="detail-qty">x{{item.number}}</text>
      <text class="detail-price">¥{{item.amount}}</text>
    </view>
  </view>

  <!-- 合计 -->
  <view class="total-bar card">
    <text class="total-label">合计</text>
    <text class="total-amount">¥{{order.amount}}</text>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar" wx:if="{{order.status === 1 || order.status === 2 || order.status === 4 || order.status === 5}}">
    <view wx:if="{{order.status === 1 || order.status === 2}}"
          class="btn btn-cancel" catchtap="cancelOrder">取消订单</view>
    <view wx:if="{{order.status === 4}}"
          class="btn btn-urge" catchtap="urgeDelivery">催单</view>
    <view wx:if="{{order.status === 5}}"
          class="btn btn-repetition" catchtap="repetition">再来一单</view>
  </view>
</view>

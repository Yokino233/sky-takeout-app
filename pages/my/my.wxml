<view class="page">
  <view class="header-bg">
    <image class="logo" src="/images/logo.png"></image>
  </view>
  <view class="user-section card">
    <image class="user-avatar" src="{{avatar || '/images/center.png'}}"></image>
    <view class="user-info">
      <view class="user-name">{{nickName || '微信用户'}}</view>
      <view class="user-login" catchtap="doLogin" wx:if="{{!token}}">
        <image class="wechat-icon" src="/images/wechat.png"></image>
        <text>点击微信登录</text>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item card" catchtap="goOrders">
      <image class="menu-icon" src="/images/order.png"></image>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item card" catchtap="goAddress">
      <image class="menu-icon" src="/images/address.png"></image>
      <text class="menu-text">地址管理</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>

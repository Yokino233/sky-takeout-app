.page {  }
.header-bg { background: #ff6b35; height: 200rpx; display: flex; align-items: center; justify-content: center; }
.logo { width: 160rpx; height: 100rpx; }
.user-section { display: flex; align-items: center; padding: 30rpx; margin: -60rpx 20rpx 0; position: relative; }
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid #fff; }
.user-info { margin-left: 24rpx; }
.user-name { font-size: 32rpx; font-weight: bold; }
.user-login { display: flex; align-items: center; font-size: 26rpx; color: #ff6b35; margin-top: 8rpx; }
.wechat-icon { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.menu-list { margin: 20rpx 20rpx 0; }
.menu-item { display: flex; align-items: center; padding: 24rpx; }
.menu-icon { width: 48rpx; height: 48rpx; }
.menu-text { flex: 1; margin-left: 20rpx; font-size: 28rpx; }
.menu-arrow { color: #ccc; font-size: 32rpx; }

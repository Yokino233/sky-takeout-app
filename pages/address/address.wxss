.page { padding: 20rpx; padding-bottom: 120rpx; }
.empty { text-align: center; padding-top: 200rpx; }
.empty-img { width: 200rpx; height: 200rpx; }
.empty-text { display: block; margin-top: 20rpx; color: #999; font-size: 28rpx; }
.address-item { margin-bottom: 16rpx; }
.addr-top { display: flex; align-items: center; }
.addr-name { font-size: 28rpx; font-weight: bold; }
.addr-phone { font-size: 26rpx; color: #666; margin-left: 20rpx; }
.select-icon { width: 36rpx; height: 36rpx; margin-left: 12rpx; }
.addr-detail { font-size: 26rpx; color: #333; margin-top: 8rpx; }
.addr-actions { display: flex; margin-top: 16rpx; gap: 20rpx; }
.action-btn { display: flex; align-items: center; font-size: 24rpx; color: #666; padding: 8rpx 16rpx; border: 2rpx solid #ddd; border-radius: 8rpx; }
.action-icon { width: 28rpx; height: 28rpx; margin-right: 6rpx; }
.add-btn-wrap { text-align: center; margin-top: 40rpx; }
.add-btn { display: inline-flex; align-items: center; justify-content: center; padding: 20rpx 60rpx; background: #ff6b35; color: #fff; border-radius: 40rpx; font-size: 28rpx; }
.add-icon { width: 32rpx; height: 32rpx; margin-right: 8rpx; }

/* 弹窗表单 */
.form-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; display: flex; align-items: center; justify-content: center; }
.form-card { background: #fff; border-radius: 16rpx; padding: 40rpx; width: 600rpx; }
.form-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 30rpx; }
.form-input { border: 2rpx solid #eee; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; margin-bottom: 20rpx; }
.form-actions { display: flex; justify-content: space-between; margin-top: 20rpx; }
.form-btn { flex: 1; text-align: center; padding: 20rpx; font-size: 28rpx; border-radius: 8rpx; }
.form-btn.cancel { border: 2rpx solid #ddd; color: #666; margin-right: 20rpx; }
.form-btn.submit { background: #ff6b35; color: #fff; }

.page { padding: 0; }

/* Tab 栏 */
.tabs {
  display: flex;
  white-space: nowrap;
  background: #fff;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  display: inline-block;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.active {
  color: #ff6b35;
  font-weight: bold;
}
.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 28rpx;
  right: 28rpx;
  height: 4rpx;
  background: #ff6b35;
  border-radius: 2rpx;
}

/* 订单卡片 */
.order-list { padding: 20rpx; }
.order-card { padding: 0; }

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 0;
}
.order-number { font-size: 24rpx; color: #999; }
.order-status { font-size: 26rpx; font-weight: bold; }

.order-time {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  padding: 6rpx 24rpx 16rpx;
}

/* 订单菜品列表 */
.order-items {
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 24rpx;
}
.order-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.order-item:last-child { margin-bottom: 0; }
.item-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
}
.item-info { flex: 1; min-width: 0; }
.item-name { font-size: 26rpx; color: #333; display: block; }
.item-flavor { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.item-right { text-align: right; min-width: 120rpx; }
.item-price { font-size: 26rpx; color: #333; display: block; }
.item-qty { font-size: 22rpx; color: #999; display: block; }

/* 底部栏 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}
.order-total { font-size: 26rpx; color: #333; }
.total-price { font-size: 30rpx; color: #ff6b35; font-weight: bold; }
.action-btns { display: flex; gap: 16rpx; }

.btn {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  text-align: center;
}
.btn-cancel {
  border: 1rpx solid #ddd;
  color: #666;
}
.btn-repetition {
  background: #ff6b35;
  color: #fff;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-img { width: 200rpx; height: 200rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }

/* 加载中 */
.loading-wrap {
  text-align: center;
  padding: 30rpx;
}
.loading-text { font-size: 24rpx; color: #999; }
